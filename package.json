{
  "name": "ez-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev:web": "bun --filter @ez/web dev",
    "lint": "biome check ./apps/web/src ./apps/web/scripts",
    "lint:fix": "biome check --write ./apps/web/src ./apps/web/scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:emulators": "bun x firebase-tools@14 emulators:start --project demo",
    "firebase:deploy-rules": "bun x firebase-tools@14 deploy --only firestore:rules",
    "admin:create": "bun --cwd apps/web scripts/create-admin.ts",
    "firebase:seed": "bun --cwd apps/web scripts/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "baseline-browser-mapping": "2.10.0",
    "turbo": "2.5.5",
    "typescript": "^5.8",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lucide-react": "^0.474.0",
    "baseline-browser-mapping": "2.10.0"
  }
}
