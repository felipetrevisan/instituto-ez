# Copie para .env.local e preencha. Em produção (Vercel), cadastre as mesmas variáveis no painel.

# URL pública do site
NEXT_PUBLIC_VERCEL_URL=https://www.institutoez.com.br

# E-mail do formulário de contato (https://resend.com)
RESEND_API_KEY=

# Firebase — Console → Configurações do projeto → Seus apps → App da Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Bucket do Storage (Configurações do projeto → storageBucket), ex.: instituto-ez.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_EMULATOR=false

# Firebase Admin — Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave entre aspas; as quebras de linha podem ficar como \n
FIREBASE_PRIVATE_KEY=

# Stripe — Dashboard → Developers → API keys (use sk_test_ para testes)
STRIPE_SECRET_KEY=

# --- Emuladores locais (opcional) ---
# NEXT_PUBLIC_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-instituto-ez
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# FIREBASE_PROJECT_ID=demo-instituto-ez
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-instituto-ez.appspot.com
