rules_version = '2';

// Estrutura (ver apps/web/src/lib/storage-keys.ts):
//   public/ebooks/<id>/…  e  public/site/…   imagens — servidas pelo site em /files/…
//   private/ebooks/<id>/…                    PDFs vendidos — só por link assinado após pagamento
//
// O site lê tudo pelo servidor (Firebase Admin, que ignora estas regras). No navegador,
// somente administradores (custom claim `admin`) leem e enviam arquivos.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif|svg[+]xml|x-icon|vnd[.]microsoft[.]icon)');
    }

    match /public/site/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isImage() && request.resource.size < 15 * 1024 * 1024;
    }

    match /public/ebooks/{ebookId}/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isImage() && request.resource.size < 15 * 1024 * 1024;
    }

    match /private/ebooks/{ebookId}/{file} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
